NODE_ENV="development"

# Database
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Used by docker-compose.yml for local postgres container
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App
CLIENT_URI=http://localhost:3000

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD_1=your_password_1
ROBOKASSA_PASSWORD_2=your_password_2
ROBOKASSA_IS_TEST=1

# Firebase
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"

# ROP External API (file storage)
ROP_API_URL=https://your-rop-host.com/api/external/v1
ROP_API_KEY=your_rop_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="AltaSales <noreply@yourdomain.com>"

# LLM PII anonymizer
LLM_ANONYMIZATION_MODE=required
LLM_ANONYMIZER_BASE_URL=http://localhost:8080
LLM_ANONYMIZER_API_KEY=your_anonymizer_api_key
LLM_ANONYMIZER_MODEL=pii-anonymizer-v1
LLM_ANONYMIZER_TIMEOUT_MS=10000
