NODE_ENV="development"

# Database
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name

# Used by docker-compose.yml for local postgres container
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App
CLIENT_URI=http://localhost:3000

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD_1=your_password_1
ROBOKASSA_PASSWORD_2=your_password_2
ROBOKASSA_IS_TEST=1

# Firebase (Auth only)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"
# Web API key — used by /auth/login-email to validate user password
# via Firebase Identity Toolkit (accounts:signInWithPassword).
# Same value as NEXT_PUBLIC_FIREBASE_API_KEY on the frontend.
FIREBASE_WEB_API_KEY=your_web_api_key

# Catalog images (local disk, free)
CATALOG_UPLOAD_DIR=./uploads
CATALOG_PUBLIC_BASE_URL=http://localhost:4000/uploads

# ROP External API (file storage + user provisioning)
ROP_API_URL=https://your-rop-host.com/api/external/v1
ROP_API_KEY=your_rop_api_key
# Roles assigned when provisioning AltaSales users in ROP CRM (scope: users)
ROP_USER_ROLE=rop
ROP_PROJECT_ROLE=rop

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="AltaSales <noreply@yourdomain.com>"

# LLM PII anonymizer
# Modes:
# - required: strict mode for external/untrusted LLM providers. The anonymizer
#   must run and policy checks fail closed when unsafe PII remains.
# - disabled_for_no_pii: hybrid mode. The anonymizer is skipped only for
#   explicitly declared no_pii requests; potentially sensitive data stays strict.
# - disabled: trusted/internal/legal LLM only. Raw prompts and responses may
#   contain PII, and the customer accepts legal and infrastructure responsibility
#   for sending that data to the selected provider.
LLM_ANONYMIZATION_MODE=required
# IMPORTANT:
# LLM_ANONYMIZER_BASE_URL receives raw user text that may contain personal data.
# It must point to a trusted/internal/self-hosted LLM endpoint or to a provider
# legally approved for processing such data.
# The application does not validate legal compliance of this URL automatically.
LLM_ANONYMIZER_BASE_URL=http://localhost:8080
LLM_ANONYMIZER_API_KEY=your_anonymizer_api_key
LLM_ANONYMIZER_MODEL=pii-anonymizer-v1
LLM_ANONYMIZER_TIMEOUT_MS=10000
LLM_ANONYMIZER_MAX_ATTEMPTS=2
LLM_ANONYMIZER_BACKOFF_BASE_MS=200
LLM_ANONYMIZER_BACKOFF_MAX_MS=1000

# Main LLM provider resilience
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_MODEL_ALIAS=chat-default
LLM_ALLOWED_PROVIDERS=mock,openai_compatible
LLM_ALLOWED_MODEL_ALIASES=mock-llm-v1,chat-default,chat-fallback,embedding-default
LLM_PROVIDER_TIMEOUT_MS=10000
LLM_PROVIDER_MAX_ATTEMPTS=2
LLM_PROVIDER_BACKOFF_BASE_MS=200
LLM_PROVIDER_BACKOFF_MAX_MS=2000

# Chat LLM fallback provider
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_MODEL_ALIAS=chat-fallback
LLM_FALLBACK_OPENAI_COMPATIBLE_BASE_URL=
LLM_FALLBACK_OPENAI_COMPATIBLE_API_KEY=
LLM_FALLBACK_OPENAI_COMPATIBLE_CHAT_MODEL=
LLM_FALLBACK_PROVIDER_TIMEOUT_MS=10000
LLM_FALLBACK_PROVIDER_MAX_ATTEMPTS=1
LLM_FALLBACK_PROVIDER_BACKOFF_BASE_MS=200
LLM_FALLBACK_PROVIDER_BACKOFF_MAX_MS=1000

# OpenAI-compatible provider real config
LLM_OPENAI_COMPATIBLE_BASE_URL=
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_CHAT_MODEL=
LLM_OPENAI_COMPATIBLE_EMBEDDING_MODEL=
LLM_OPENAI_COMPATIBLE_EMBEDDING_DIMENSIONS=
LLM_OPENAI_COMPATIBLE_EMBEDDING_IS_EXTERNAL=true

# Embedding provider
LLM_EMBEDDING_PROVIDER=openai_compatible
LLM_EMBEDDING_MODEL_ALIAS=embedding-default
LLM_EMBEDDING_TIMEOUT_MS=10000
LLM_EMBEDDING_MAX_ATTEMPTS=2
LLM_EMBEDDING_BACKOFF_BASE_MS=200
LLM_EMBEDDING_BACKOFF_MAX_MS=2000

# Qdrant vector storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=altasales_knowledge_chunks
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine

# Knowledge ingestion
KNOWLEDGE_MAX_FILE_SIZE_MB=100
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=1000
KNOWLEDGE_CHUNK_SIZE_CHARS=4000
KNOWLEDGE_CHUNK_OVERLAP_CHARS=500
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_URL_TIMEOUT_MS=10000
KNOWLEDGE_URL_MAX_REDIRECTS=3
KNOWLEDGE_URL_MAX_RESPONSE_SIZE_BYTES=1000000

# Chatbot RAG pipeline (ChatbotRagService)
# Number of chunks pulled from KnowledgeSearchService for one question.
CHATBOT_RAG_RETRIEVAL_LIMIT=6
# Minimum relevance score for a retrieved chunk to be usable. 0 disables the filter.
CHATBOT_RAG_MIN_SCORE=0.35
# LLM cache TTL for repeated questions (bypassed if the question triggers anonymization).
CHATBOT_RAG_CACHE_TTL_MS=300000
# Total prompt char budget (system + question + context blocks). Overflow is trimmed
# lowest-score first; if even the top chunk cannot fit, the request is refused.
CHATBOT_RAG_MAX_CONTEXT_CHARS=12000

# Chatbot conversation memory (ChatbotHistorySlicerService, ChatbotQueryRewriterService)
# Max number of most-recent history messages kept when building LLM context.
CHATBOT_HISTORY_MAX_MESSAGES=10
# Total char budget for the sliced history window. The newest message is kept
# even if it alone exceeds the budget.
CHATBOT_HISTORY_MAX_CHARS=8000
# Turns follow-ups like "а сколько он стоит?" into standalone search queries
# before knowledge retrieval. Disable to fall back to the raw user question.
CHATBOT_QUERY_REWRITE_ENABLED=true
# History window (most-recent messages) used as context for the rewrite call.
CHATBOT_QUERY_REWRITE_MAX_HISTORY_MESSAGES=6

# OCR is disabled by default. OCR text may contain PII.
# For sensitive documents, prefer local/self-hosted OCR.
# tesseract_cli requires tesseract in the backend runtime/container.
# PDF OCR fallback also requires poppler/pdftoppm in the backend runtime/container.
KNOWLEDGE_OCR_PROVIDER=disabled
KNOWLEDGE_OCR_LANGUAGES=rus+eng
KNOWLEDGE_OCR_TIMEOUT_MS=30000
KNOWLEDGE_OCR_MAX_PAGES=10
KNOWLEDGE_OCR_MIN_TEXT_LENGTH=50
KNOWLEDGE_OCR_TEMP_DIR=
OMP_THREAD_LIMIT=1

# Transcription is disabled by default.
# Audio and transcripts may contain PII.
# Use Yandex/RU provider or another legally approved provider for sensitive data.
# Object Storage is used only as temporary transport for Yandex async recognition.
# Uploaded audio objects are deleted after transcription job completion or failure.
# Transcript text and segments are stored in Postgres as the business result.
# Video transcription extracts an audio track locally with ffmpeg,
# then reuses the audio transcription flow. Original video is not stored permanently.
# Requires ffmpeg with libopus support in the backend runtime/container.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_MAX_AUDIO_SIZE_MB=100
TRANSCRIPTION_MAX_VIDEO_SIZE_MB=500
TRANSCRIPTION_OPERATION_TIMEOUT_MS=900000
TRANSCRIPTION_POLL_INTERVAL_MS=5000
TRANSCRIPTION_PROVIDER_REQUEST_TIMEOUT_MS=30000
TRANSCRIPTION_VIDEO_EXTRACTION_TIMEOUT_MS=300000
TRANSCRIPTION_FFMPEG_PATH=ffmpeg
TRANSCRIPTION_VIDEO_TEMP_DIR=

YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=
YANDEX_SPEECHKIT_LANGUAGE=ru-RU

# Required only for Yandex SpeechKit async recognition transport.
YANDEX_OBJECT_STORAGE_BUCKET=
YANDEX_OBJECT_STORAGE_REGION=ru-central1
YANDEX_OBJECT_STORAGE_ACCESS_KEY_ID=
YANDEX_OBJECT_STORAGE_SECRET_ACCESS_KEY=
